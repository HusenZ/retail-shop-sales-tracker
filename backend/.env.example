# PostgreSQL connection (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5432/shop_tracker

# Used only by the test suite; tables in this database are wiped during tests
TEST_DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5432/shop_tracker_test

# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Long-lived token so shop owners are not logged out every day
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Timezone used to decide what "today", "this week" and "this month" mean
SHOP_TIMEZONE=Asia/Kolkata

# Comma-separated list, only needed for browser clients
CORS_ORIGINS=
